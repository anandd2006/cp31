#include <bits/stdc++.h>
using namespace std;
 
using ll = long long;
 
#define all(x) (x).begin(), (x).end()
#define rall(x) (x).rbegin(), (x).rend()
 
const ll INF = 1e18;
const int MOD = 1e9 + 7;
 
void solve() {
    string s;
    cin>>s;
    int n=s.size();
    vector<int> freq(26,0);
    for(char &c:s)freq[c-'a']++;
    int k=0;
    for(int &x:freq){
        if(x>0)k++;
    }
    for (int i = k; i < (int)s.size(); i++) {
        if (s[i] != s[i - k]) {
            cout << "NO
";
            return;
        }
    }
 
    cout<<"YES
";
}
 
int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
 
    int t;
    cin >> t;
 
    while (t--) {
        solve();
    }
 
    return 0;
}