#include <bits/stdc++.h>
using namespace std;
 
int main()
{
    int t;
    cin >> t;
 
    while (t--)
    {
        int n, k;
        cin>>n>>k;
        vector<int>v(n,0);
        for(int i=0;i<n;i++){
            cin>>v[i];
        }
        bool found=false;
        for(int i=0;i<n;i++){
            if(v[i]==k)found=true;
            else continue;
        }
        if(found){
            cout<<"YES
";
        }else{
            cout<<"NO
";
        }
    }
 
    return 0;
}